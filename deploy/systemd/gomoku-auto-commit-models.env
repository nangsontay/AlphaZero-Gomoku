# Copy this file to /etc/default/gomoku-auto-commit-models and adjust values before enabling the timer.
# Example:
#   sudo install -m 0644 deploy/systemd/gomoku-auto-commit-models.env /etc/default/gomoku-auto-commit-models

PROJECT_DIR=/root/AlphaZero-Gomoku
# Commit the hourly checkpoint and its metadata sidecar. Use MODEL_PATHSPEC=*.model
# instead if you want the timer to commit every top-level model checkpoint.
MODEL_PATHS="hourly_policy.model hourly_policy.model.json"
REQUIRED_PATH=hourly_policy.model
GIT_BIN=git
GIT_REMOTE=origin
COMMIT_MESSAGE_PREFIX="chore(checkpoint): auto-commit hourly policy checkpoint"
